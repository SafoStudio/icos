extend type Query {
    user(id: ID!): User!
    usersByCompany(companyId: ID!): [User!]!
}

extend type Mutation {
    createUser(input: UserCreateInput!): User!
    updateUser(id: ID!, input: UserUpdateInput!): User!
    updateProfile(userId: ID!, input: ProfileUpdateInput!): UserProfile!
    deleteUser(id: ID!): Boolean!
    activateUser(id: ID!): Boolean!
    suspendUser(id: ID!): Boolean!
}

type User {
    id: ID!
    email: String!
    firstName: String!
    lastName: String!
    companyId: ID!
    role: String!
    departmentId: ID
    department: Department
    status: String
    permissions: [String!]!
    profile: UserProfile
    documents: [UserDocument!]
}

type UserDocument {
    id: ID!
    type: String!
    filename: String!
    filePath: String!
    contentType: String
    fileSize: Float
    createdAt: String
}

type UserProfile {
    userId: ID!
    phoneNumber: String
    address: String
    hireDate: Date
    birthDate: Date
    avatarPath: String
}

input UserCreateInput {
    email: String!
    firstName: String!
    lastName: String!
    companyId: ID!
}

input UserUpdateInput {
    firstName: String
    lastName: String
    email: String
    role: String
    departmentId: ID
}

input ProfileUpdateInput {
    phoneNumber: String
    address: String
    hireDate: Date
    birthDate: Date
}
