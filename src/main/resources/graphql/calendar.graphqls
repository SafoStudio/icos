type EventParticipant {
    userId: ID!
    status: String!
    user: User
}

type Event {
    id: ID!
    userId: ID!
    title: String!
    description: String
    startAt: String!
    endAt: String!
    type: String
    source: String
    visibility: String
    participantIds: [ID!]!
    participants: [User!]!
    participantDetails: [EventParticipant!]!
    organizer: User
    currentUserStatus: String
}

extend type Query {
    calendarEvents(start: String!, end: String!): [Event!]!
}

extend type Mutation {
    createCalendarEvent(
        title: String!,
        description: String,
        start: String!,
        end: String!,
        participantIds: [ID!]
    ): Event!
    updateCalendarEvent(
        id: ID!,
        title: String!,
        description: String,
        start: String!,
        end: String!,
        participantIds: [ID!]
    ): Event!
    updateEventAttendance(
        eventId: ID!,
        status: String!
    ): Event!
    deleteCalendarEvent(id: ID!): Boolean!
}
