type Event {
    id: ID!
    userId: ID!
    title: String!
    description: String
    startAt: String!
    endAt: String!
    type: String
    source: String
    visibility: String
    participantIds: [ID!]!
    participants: [User!]!
    organizer: User
}

extend type Query {
    calendarEvents(start: String!, end: String!): [Event!]!
}

extend type Mutation {
    createCalendarEvent(
        title: String!,
        description: String,
        start: String!,
        end: String!,
        participantIds: [ID!]
    ): Event!
    deleteCalendarEvent(id: ID!): Boolean!
}


