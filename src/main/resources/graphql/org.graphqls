type Company {
    id: ID!
    name: String!
    taxId: String
}

type Department {
    id: ID!
    companyId: ID!
    name: String!
    description: String
}

type Position {
    id: ID!
    companyId: ID!
    name: String!
    description: String
}

type Permission {
    id: ID!
    name: String!
}

extend type Query {
    company(id: ID!): Company
    departments(companyId: ID!): [Department!]!
    positions(companyId: ID!): [Position!]!
    departmentPermissions(departmentId: ID!, roleName: String!): [Permission!]!
}

extend type Mutation {
    createCompany(name: String!, taxId: String): Company
    createDepartment(name: String!, description: String): Department
    updateDepartment(id: ID!, name: String, description: String): Department
    createPosition(name: String!, description: String): Position
    updatePosition(id: ID!, name: String, description: String): Position
    deleteDepartment(id: ID!): Boolean!
    deletePosition(id: ID!): Boolean!
    assignDepartmentPermission(departmentId: ID!, roleName: String!, permissionId: ID!): Boolean!
    revokeDepartmentPermission(departmentId: ID!, roleName: String!, permissionId: ID!): Boolean!
}


