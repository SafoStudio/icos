type User {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    status: UserStatus!
    companyId: ID!
    createdBy: ID!
    createdAt: String!
    updatedAt: String!
}

enum UserStatus {
    INVITED
    ACTIVE
    SUSPENDED
    DELETED
}

type Query {
    getUserById(id: ID!): User
    getUserByEmail(email: String!, companyId: ID!): User
    getUsersByCompanyId(companyId: ID!): [User!]
}

type Mutation {
    createUser(firstName: String!, lastName: String!, email: String!, companyId: ID!, createdBy: ID!): User!
    updateUser(id: ID!, firstName: String, lastName: String, email: String, updatedBy: ID!): User!
    activateUser(id: ID!): Boolean!
    suspendUser(id: ID!): Boolean!
    terminateUser(id: ID!): Boolean!
    deleteUser(id: ID!): Boolean!
}