enum EntityType {
    USER
    COMPANY
    DEPARTMENT
    POSITION
    JOB
    CANDIDATE
    ONBOARDING
}

enum FieldType {
    STRING
    MULTILINE
    NUMBER
    DATE
    BOOLEAN
    ENUM
    MULTI_SELECT
    URL
    ENTITY_REF
}

type CustomFieldDefinition {
    id: UUID!
    entityType: EntityType!
    key: String!
    label: String!
    fieldType: FieldType!
    refEntityType: String
    required: Boolean!
    filterable: Boolean!
    options: [String!]
    description: String
    placeholder: String
    defaultValue: String
    validationRegex: String
    validationMessage: String
    minValue: Float
    maxValue: Float
    conditionalFieldKey: String
    conditionalValue: String
    orderIndex: Int!
    createdAt: DateTime
    updatedAt: DateTime
}

type CustomFieldValue {
    id: UUID!
    entityType: EntityType!
    entityId: UUID!
    definition: CustomFieldDefinition!
    valueText: String
    valueNumber: Float
    valueBool: Boolean
    valueDate: DateTime
    valueEntityId: UUID
    valueEntityType: String
    createdAt: DateTime
    updatedAt: DateTime
}

input CustomFieldDefinitionInput {
    entityType: EntityType!
    key: String!
    label: String!
    fieldType: FieldType!
    refEntityType: String
    required: Boolean = false
    filterable: Boolean = true
    options: [String!]
    description: String
    placeholder: String
    defaultValue: String
    validationRegex: String
    validationMessage: String
    minValue: Float
    maxValue: Float
    conditionalFieldKey: String
    conditionalValue: String
    orderIndex: Int = 0
}

input UpdateCustomFieldDefinitionInput {
    label: String
    fieldType: FieldType
    refEntityType: String
    required: Boolean
    filterable: Boolean
    options: [String!]
    description: String
    placeholder: String
    defaultValue: String
    validationRegex: String
    validationMessage: String
    minValue: Float
    maxValue: Float
    conditionalFieldKey: String
    conditionalValue: String
    orderIndex: Int
}

input CustomFieldValueInput {
    entityType: EntityType!
    entityId: UUID!
    fieldKey: String!
    value: String
}

extend type Query {
    customFieldDefinitions(entityType: EntityType): [CustomFieldDefinition!]!
    allCustomFieldDefinitions: [CustomFieldDefinition!]!
    customFieldDefinition(id: UUID!): CustomFieldDefinition
    customFieldValues(entityType: EntityType!, entityId: UUID!): [CustomFieldValue!]!
}

extend type Mutation {
    createCustomFieldDefinition(input: CustomFieldDefinitionInput!): CustomFieldDefinition!
    updateCustomFieldDefinition(id: UUID!, input: CustomFieldDefinitionInput!): CustomFieldDefinition!
    deleteCustomFieldDefinition(id: UUID!): Boolean!
    setCustomFieldValue(input: CustomFieldValueInput!): CustomFieldValue!
    setCustomFieldValues(inputs: [CustomFieldValueInput!]!): [CustomFieldValue!]!
    deleteCustomFieldValue(id: UUID!): Boolean!
}


