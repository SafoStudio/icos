extend type Query {
    vacancies(companyId: UUID!): [Vacancy!]!
    vacancy(id: UUID!): Vacancy
    application(id: UUID!): Application
    kanbanBoard(vacancyId: UUID!): KanbanBoard!
}

extend type Mutation {
    createVacancy(input: CreateVacancyInput!): Vacancy!
    applyToVacancy(vacancyId: UUID!, candidate: CandidateInput!): Application!
    moveApplication(applicationId: UUID!, stageId: UUID!): Application!
    hireCandidate(applicationId: UUID!, userId: UUID!): Application!
    updateVacancyStatus(vacancyId: UUID!, status: VacancyStatus!): Vacancy!
}

type Vacancy {
    id: UUID!
    companyId: UUID!
    departmentId: UUID
    positionId: UUID
    title: String!
    description: String
    requirements: String
    status: VacancyStatus!
    createdAt: DateTime!
}

type Application {
    id: UUID!
    candidate: Candidate!
    vacancyId: UUID!
    currentStageId: UUID
    status: ApplicationStatus!
    createdAt: DateTime!
}

type VacancyStage {
    id: UUID!
    name: String!
    type: PipelineStageType!
    orderIndex: Int!
}

type KanbanBoard {
    vacancyId: UUID!
    columns: [KanbanColumn!]!
}

type KanbanColumn {
    stage: VacancyStage!
    applications: [Application!]!
}

type Candidate {
    id: UUID!
    firstName: String!
    lastName: String!
    email: String!
    phone: String
    source: String
    resumeUrl: String
}

input CreateVacancyInput {
    companyId: UUID!
    departmentId: UUID
    positionId: UUID
    title: String!
    description: String
    requirements: String
}

input CandidateInput {
    firstName: String!
    lastName: String!
    email: String!
    phone: String
    source: String
    resumeUrl: String
}

enum VacancyStatus {
    DRAFT
    OPEN
    CLOSED
    PAUSED
}

enum ApplicationStatus {
    ACTIVE
    HIRED
    REJECTED
    WITHDRAWN
}

enum PipelineStageType {
    APPLIED
    SCREENING
    TECHNICAL
    HR
    OFFER
    HIRED
    REJECTED
}


